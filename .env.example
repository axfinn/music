# 部署变量样例 —— 复制成 .env 后按需修改（.env 已 gitignore，不会进仓库）。
#
#   cp .env.example .env
#
# 这些变量被 docker-compose.yml 与 scripts/deploy.sh 共同读取。

# 宿主机端口（容器内固定 8080）
HOST_PORT=8083

# 容器时区
TZ=Asia/Shanghai

# 后台管理口令。
# 留空 = 纯访客模式：音乐库能听，歌词库 / 发现 / 上传全部关闭。
# 想进后台就设一个足够长的口令；改口令会让所有旧会话立即失效。
ADMIN_PASSWORD=

# 站点身份（不重启容器也能换站名 / 域名，前端从 /api/site 读取）。
# SITE_NAME=music
# SITE_TAGLINE=独立音乐站
# SITE_DESCRIPTION=私人曲库与歌词档案
SITE_BASE_URL=https://music.jaxiu.cn

# 对外 /api/v1/* 公共设置（对应 config.yaml 的 api 段）。
# API_KEY_RATE_LIMIT=60
# API_ALLOW_ORIGINS=https://music.jaxiu.cn,https://app.example.com

# 发布用的镜像名与标签。
# deploy.sh update 会自动用 git 短 sha 覆盖 MUSIC_TAG，便于回滚。
MUSIC_IMAGE=music
MUSIC_TAG=latest

# 备份目录（scripts/deploy.sh backup 用）
BACKUP_DIR=./backups
