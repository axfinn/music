# 部署变量样例 —— 复制成 .env 后按需修改（.env 已 gitignore，不会进仓库）。
#
#   cp .env.example .env
#
# 这些变量被 docker-compose.yml 与 scripts/deploy.sh 共同读取。

# 宿主机端口（容器内固定 8080）
HOST_PORT=8083

# 容器时区
TZ=Asia/Shanghai

# 后台管理口令。
# 留空 = 纯访客模式：音乐库能听，歌词库 / 发现 / 上传全部关闭。
# 想进后台就设一个足够长的口令；改口令会让所有旧会话立即失效。
ADMIN_PASSWORD=

# ── 邮箱会员（注册 / 登录 / 找回）──
# 邮件服务提供的 client_credentials（client_id: mt_xxx）。
# 只有这两项都配了，站点的会员注册/登录入口才会开放。
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
# from 必须落在发信业务的白名单内，否则发验证码会被上游 403 拒绝。
# 请先在 t.jaxiu.cn 控制台确认白名单地址，再填到这里。
MAIL_FROM=devtools@jaxiu.cn
# MAIL_FROM_NAME=music
# MAIL_BASE_URL=https://t.jaxiu.cn/api/mail/v1
# AUTH_ENABLED=true
# AUTH_CODE_TTL_MINUTES=10
# AUTH_SESSION_TTL_HOURS=720
# AUTH_CODE_RATE_LIMIT=3

# 站点身份（不重启容器也能换站名 / 域名，前端从 /api/site 读取）。
# SITE_NAME=music
# SITE_TAGLINE=独立音乐站
# SITE_DESCRIPTION=私人曲库与歌词档案
SITE_BASE_URL=https://music.jaxiu.cn

# 对外 /api/v1/* 公共设置（对应 config.yaml 的 api 段）。
# API_KEY_RATE_LIMIT=60
# API_ALLOW_ORIGINS=https://music.jaxiu.cn,https://app.example.com

# 完全放行的自家域名（含子域），逗号分隔。
# 留空时自动从 SITE_BASE_URL 取主域：这里是 jaxiu.cn，
# 即 devtools.jaxiu.cn 等站点可直接跨域调用本站接口，不受反爬与 CORS 白名单限制。
# ANTI_CRAWL_TRUSTED_DOMAINS=jaxiu.cn,other.example.com

# 发布用的镜像名与标签。
# deploy.sh update 会自动用 git 短 sha 覆盖 MUSIC_TAG，便于回滚。
MUSIC_IMAGE=music
MUSIC_TAG=latest

# 备份目录（scripts/deploy.sh backup 用）
BACKUP_DIR=./backups
